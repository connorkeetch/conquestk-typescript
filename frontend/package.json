{
  "name": "conquestk-frontend",
  "version": "1.0.0",
  "description": "React frontend for Risk-like multiplayer board game",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/sync-brand-svg.mjs && node ../scripts/generate-icons.mjs && node scripts/generate-pwa-assets.mjs && node scripts/hash-icons.mjs && node scripts/publish-cdn-assets.mjs",
    "build": "vite build",
    "build:check": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:strict-optional": "tsc -p tsconfig.strict-optional.json --noEmit",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@fontsource/audiowide": "^5.2.7",
    "@fontsource/chewy": "^5.2.7",
    "@fontsource/creepster": "^5.2.7",
    "@fontsource/metal-mania": "^5.2.7",
    "@fontsource/new-rocker": "^5.2.7",
    "@fontsource/rye": "^5.2.7",
    "@hookform/resolvers": "5.2.2",
    "@reduxjs/toolkit": "^2.9.0",
    "@conquestk/shared": "file:../shared",
    "@tailwindcss/vite": "^4.1.13",
    "@types/dompurify": "^3.0.5",
    "@types/uuid": "^10.0.0",
    "axios": "^1.21.1",
    "bad-words": "^4.0.0",
    "dompurify": "^3.4.17",
    "emoji-picker-react": "^4.13.3",
    "favico.js": "^0.3.10",
    "framer-motion": "12.23.22",
    "howler": "^2.2.4",
    "lucide-react": "0.545.0",
    "preline": "^3.2.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.63.0",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.9.2",
    "socket.io-client": "^4.8.1",
    "uuid": "^11.0.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "@vitest/ui": "5.1.0",
    "autoprefixer": "^10.4.21",
    "jsdom": "26.1.0",
    "postcss": "8.5.33",
    "sharp": "^0.35.5",
    "@types/howler": "^2.2.11",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.11",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  }
}
