{
  "name": "conquestk-backend",
  "version": "1.0.0",
  "description": "Backend server for Risk-like multiplayer board game",
  "main": "dist-esm/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --exec node --loader ts-node/esm src/index.ts",
    "prebuild": "cd ../shared && npm run build && cd ../shared/match-client && npm run build",
    "build": "tsc -p tsconfig.esm.json && tsc-alias -p tsconfig.esm.json",
    "build:esm": "tsc -p tsconfig.esm.json && tsc-alias -p tsconfig.esm.json",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc -p tsconfig.strict.json --noEmit",
    "postbuild": "node scripts/copy-migrations.cjs",
    "start": "node dist-esm/index.js",
    "start:legacy-sequence": "node dist-esm/scripts/runMigration.js && node dist-esm/scripts/ensureDeployAccounts.js && ( [ \"$SYNC_FEATURE_FLAGS_ON_START\" = \"true\" ] && node dist-esm/scripts/checkFeatureFlags.js --apply || echo \"Skipping feature flag sync (set SYNC_FEATURE_FLAGS_ON_START=true to enable)\" ) && node dist-esm/index.js",
    "start:sync-flags": "node dist-esm/scripts/runMigration.js && node dist-esm/scripts/ensureDeployAccounts.js && node dist-esm/scripts/checkFeatureFlags.js --apply && node dist-esm/index.js",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "seed:users": "ts-node src/scripts/seedUsers.ts",
    "dev:esm": "nodemon --exec node --loader ts-node/esm src/index.ts",
    "seed": "npm run seed:users",
    "make-admin": "ts-node src/scripts/makeAdmin.ts",
    "diagnose-admin": "ts-node src/scripts/diagnoseAdminIssue.ts",
    "setup-production-admin": "ts-node src/scripts/setupProductionAdmin.ts",
    "migrate": "ts-node src/scripts/runMigration.ts",
    "test:email": "ts-node src/scripts/testEmail.ts",
    "check:schema": "ts-node src/scripts/checkSchema.ts",
    "migrate:status": "ts-node src/scripts/checkSchema.ts",
    "migrate:squash": "ts-node src/scripts/squashMigrations.ts",
    "notify": "ts-node src/scripts/notify.ts",
    "backfill:conversation-read": "ts-node src/scripts/backfillConversationReadState.ts",
    "flags:check": "ts-node src/scripts/checkFeatureFlags.ts",
    "flags:sync": "ts-node src/scripts/checkFeatureFlags.ts --apply",
    "flags:check:runtime": "node dist-esm/scripts/checkFeatureFlags.js",
    "flags:sync:runtime": "node dist-esm/scripts/checkFeatureFlags.js --apply",
    "purge:messages": "ts-node src/scripts/purgeMessaging.ts",
    "purge:messages:yes": "ts-node src/scripts/purgeMessaging.ts --yes",
    "wipe:games": "ts-node src/scripts/wipeGames.ts",
    "wipe:games:yes": "ts-node src/scripts/wipeGames.ts --yes",
    "wipe:redis": "ts-node src/scripts/wipeRedisGames.ts",
    "wipe:redis:yes": "ts-node src/scripts/wipeRedisGames.ts --yes",
    "purge:messages:include-blocks": "ts-node src/scripts/purgeMessaging.ts --yes --include-user-blocks",
    "maps:import": "ts-node src/scripts/importMapsPackage.ts",
    "maps:variants": "ts-node src/scripts/generateMapImageVariants.ts",
    "maps:fix-image-urls": "ts-node src/scripts/fixMapImageUrls.ts",
    "maps:rebuild-adj": "ts-node src/scripts/rebuildAdjacencies.ts",
    "replay:match": "ts-node src/scripts/replayMatch.ts",
    "replay:export": "ts-node src/scripts/exportReplayFrames.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/lib-storage": "^3.896.0",
    "@conquestk/match-client": "file:../shared/match-client",
    "@conquestk/shared": "file:../shared",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/node": "^10.78.0",
    "@socket.io/redis-streams-adapter": "^0.2.2",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.1",
    "@types/sharp": "^0.31.1",
    "@types/validator": "^13.15.3",
    "adm-zip": "^0.6.1",
    "bad-words": "^4.0.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.61.0",
    "connect-redis": "^9.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.18.2",
    "express-slow-down": "^3.0.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "image-size": "^2.0.2",
    "ioredis": "^5.8.1",
    "joi": "^18.3.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "nodemailer": "^10.1.4",
    "open-graph-scraper": "^6.10.0",
    "pg": "^8.16.3",
    "rate-limit-redis": "^4.2.2",
    "resend": "^6.1.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.3",
    "validator": "^13.15.15",
    "web-push": "^3.6.7",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-redis": "^0.0.23",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/express-slow-down": "^1.3.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "jest": "^30.1.3",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  }
}
