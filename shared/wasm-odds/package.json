{
  "name": "@conquestk/wasm-odds",
  "version": "0.1.0",
  "description": "Risk combat odds in Rust → WebAssembly for Node and browser",
  "type": "module",
  "private": true,
  "scripts": {
    "wasm:build": "RUSTFLAGS='-C target-feature=+simd128' wasm-pack build --release --target bundler --out-dir ../pkg crate && RUSTFLAGS='-C target-feature=+simd128' wasm-pack build --release --target nodejs --out-dir ../pkg-node crate && node ./scripts/opt-wasm.js",
    "build:ts": "tsc -p tsconfig.json",
    "wasm:build:dev": "wasm-pack build --dev --target bundler --out-dir pkg crate",
    "test:rs": "cd crate && cargo test",
    "bench:rs": "cd crate && cargo bench",
    "test:ts": "vitest run",
    "lint:rs": "cd crate && cargo clippy --all-targets -- -D warnings",
    "fmt:check": "cd crate && cargo fmt --all -- --check",
    "fmt:write": "cd crate && cargo fmt --all",
    "build": "npm run wasm:build && npm run build:ts"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": ["dist/*"],
      "types": ["dist/types.d.ts"],
      "types/*": ["dist/types.d.ts"]
    }
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "5.1.0"
  },
  "keywords": [
    "risk",
    "wasm",
    "odds",
    "monte-carlo",
    "rust",
    "xoshiro"
  ]
}
