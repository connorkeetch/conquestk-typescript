{
  "name": "conquestk",
  "version": "1.0.0",
  "description": "A full-stack Risk-like multiplayer board game",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "prebuild": "cd shared/wasm-odds && npm run build:ts",
    "setup": "node scripts/setup-check.cjs",
    "dev": "powershell -ExecutionPolicy Bypass -File ./scripts/start-dev.ps1",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:manual": "npm run check:services || true && concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend-only": "powershell -ExecutionPolicy Bypass -File ./scripts/start-dev.ps1 -Frontend",
    "dev:backend-only": "powershell -ExecutionPolicy Bypass -File ./scripts/start-dev.ps1 -Backend",
    "dev:quick": "powershell -ExecutionPolicy Bypass -File ./scripts/start-dev.ps1 -SkipSetup",
    "build": "npm run build:shared && npm run build:frontend && npm run build:backend",
    "build:shared": "cd shared && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "gen:icons": "node scripts/generate-icons.mjs",
    "gen:pwa-assets": "cd frontend && node scripts/generate-pwa-assets.mjs",
    "gen:og": "cd frontend && node scripts/generate-og.mjs",
    "prestart": "npm run build",
    "start": "npm --prefix backend start",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test",
    "lint": "npx biome check .",
    "lint:fix": "npx biome check --write .",
    "format": "npx biome format --write .",
    "typecheck": "npm run typecheck:shared && npm run typecheck:backend && npm run typecheck:frontend",
    "typecheck:backend": "cd backend && npm run typecheck",
    "typecheck:frontend": "cd frontend && npm run typecheck",
    "typecheck:frontend:strict": "cd frontend && npm run typecheck:strict-optional",
    "typecheck:shared": "cd shared && npm run typecheck",
    "check": "npx biome check --write .",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "clean": "rmdir /s /q backend\\node_modules frontend\\node_modules 2>nul || true",
    "clean:install": "npm run clean && npm run install:all",
    "test:ci": "npm run test:backend && npm run test:frontend",
    "docs:schema": "cd backend && NODE_ENV=production npm run check:schema -- --skip-validation --skip-row-counts --export ../docs/operations/database-schema.md",
    "check:services": "node scripts/ensure-services.cjs",
    "check:services:start": "node scripts/ensure-services.cjs --start",
    "setup:env": "node scripts/setup-environments.cjs",
    "generate:odds": "node scripts/generateCombatOutcomes.cjs",
    "codemod:esm:check": "node scripts/codemods/ensure-import-extensions.mjs --target backend/src",
    "codemod:esm:apply": "node scripts/codemods/ensure-import-extensions.mjs --target backend/src --apply",
    "scan:requires": "node scripts/codemods/scan-requires.mjs --target backend/src",
    "odds:build": "cd shared/wasm-odds && npm run build",
    "odds:test": "cd shared/wasm-odds && npm run build && npm run test:rs && npm run test:ts && cd ../../ && npm run build:shared && vitest run -c tests/vitest.odds.config.ts",
    "odds:bench": "cd shared/wasm-odds && npm run build && npm run bench:rs && node ../../scripts/bench-odds.js && node ../../scripts/bench-odds-mc.js && node ../../scripts/update-odds-bench-docs.js",
    "odds:lint:rs": "cd shared/wasm-odds && npm run lint:rs",
    "odds:fmt:check": "cd shared/wasm-odds && npm run fmt:check",
    "odds:fmt:write": "cd shared/wasm-odds && npm run fmt:write",
    "health:report": "node scripts/api-health-check.mjs",
    "health:publish": "node scripts/api-health-check.mjs --publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ConnorKeetch/conquestk.git"
  },
  "keywords": [
    "risk",
    "board-game",
    "multiplayer",
    "react",
    "nodejs",
    "socket.io",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.5",
    "@playwright/test": "^1.55.1",
    "@types/node": "^24.5.2",
    "concurrently": "^8.2.2",
    "vitest": "5.1.0"
  },
  "workspaces": [
    "frontend",
    "backend",
    "shared",
    "shared/wasm-odds",
    "shared/match-client"
  ],
  "overrides": {
    "simple-swizzle": "0.2.2",
    "uuid": "11.1.0"
  },
  "resolutions": {
    "simple-swizzle": "0.2.2",
    "uuid": "11.1.0"
  }
}
